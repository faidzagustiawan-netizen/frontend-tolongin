# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# Keluaran Playwright. Keduanya sempat ter-commit — laporan HTML 525 KB yang
# ditulis ulang setiap kali suite dijalankan.
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify knowledge graph (build artifact, regenerate with `graphify extract . --code-only`)
graphify-out/
.graphify_analysis.json
.graphify_labels.json

# Claude Code local config (contains machine-specific absolute paths)
.claude/
